<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/button_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item
                android:left="0dp"
                android:right="2dp"
                android:top="0dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/shadow_medium" />
                </shape>
            </item>

            <!-- FAB layer with gradient -->
            <item
                android:left="0dp"
                android:right="0dp"
                android:top="0dp"
                android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:endColor="@color/gradient_end"
                        android:startColor="@color/gradient_start"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
