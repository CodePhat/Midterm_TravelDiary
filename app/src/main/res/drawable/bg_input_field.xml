<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_light" />
            <stroke
                android:width="2dp"
                android:color="@color/primary_blue" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Error state (enabled but not focused) -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_light" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_light" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_light" />
            <stroke
                android:width="1dp"
                android:color="@color/divider_light" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
