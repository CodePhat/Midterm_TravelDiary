<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected/Checked state - white text -->
    <item android:state_selected="true" android:color="@color/text_on_primary" />
    <item android:state_checked="true" android:color="@color/text_on_primary" />
    <item android:state_activated="true" android:color="@color/text_on_primary" />

    <!-- Default state - primary text -->
    <item android:color="@color/text_secondary_light" />
</selector>
