<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Bottom Wave Decoration (behind everything) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:src="@drawable/bottom_wave"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@string/bottom_wave_description" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/loginLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/login_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Travel Diary Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"/>

        <!-- Welcome Title -->
        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:textAlignment="center"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/loginLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/welcomeSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/welcome_subtitle"
            android:textSize="16sp"
            android:textColor="@color/text_secondary_light"
            android:textAlignment="center"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/welcomeTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>

        <!-- Login Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/loginCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_elevated"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_light"
            app:layout_constraintTop_toBottomOf="@id/welcomeSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Name Input (for signup) -->
                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_full_name"
                    android:inputType="text"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_tertiary_light"
                    android:visibility="gone"/>

                <!-- Spacing for name input -->
                <Space
                    android:id="@+id/nameSpace"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:visibility="gone"/>

                <!-- Email Input -->
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_tertiary_light"/>

                <!-- Spacing -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <!-- Password Input -->
                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_tertiary_light"/>

                <!-- Spacing -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp"/>

                <!-- Action Button (Login/Sign Up) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/action_sign_in"
                    android:textColor="@color/text_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    app:cornerRadius="24dp"
                    app:rippleColor="@color/primary_blue_dark"/>

                <!-- Spacing -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <!-- Toggle Button (Switch between Login/Sign Up) -->
                <TextView
                    android:id="@+id/toggleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_signup"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <!-- Social Login Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider_light"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_divider_text"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary_light"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider_light"/>
                </LinearLayout>

                <!-- Social Login Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="2">

                    <!-- Google Login -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoginGoogle"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/google"
                        android:textColor="@color/text_primary_light"
                        android:textSize="14sp"
                        android:background="@drawable/bg_button_outline"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@null"
                        android:layout_marginEnd="8dp"
                        app:rippleColor="@color/divider_light"/>

                    <!-- Apple Login -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoginApple"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/apple"
                        android:textColor="@color/text_primary_light"
                        android:textSize="14sp"
                        android:background="@drawable/bg_button_outline"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_apple"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/text_primary_light"
                        android:layout_marginStart="8dp"
                        app:rippleColor="@color/divider_light"/>
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Bottom Spacing -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/loginCard"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

</FrameLayout>
