<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="20dp">

            <!-- Greeting Text -->
            <LinearLayout
                android:id="@+id/greetingLayout"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/profileImage">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi Bella,"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_light"/>

                <TextView
                    android:id="@+id/greetingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Travelling Today?"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Profile Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/img"
                android:scaleType="centerCrop"
                android:contentDescription="Profile Picture"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="@color/primary_blue"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toTopOf="@id/greetingLayout"
                app:layout_constraintBottom_toBottomOf="@id/greetingLayout"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Search Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    app:tint="@color/text_tertiary_light"/>

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search destination..."
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_tertiary_light"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:inputType="text"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Beach Chip -->
                <LinearLayout
                    android:id="@+id/chipBeach"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_beach"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_beach"
                        android:contentDescription="Beach"
                        app:tint="@color/chip_beach"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beach"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/chip_beach"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Mountain Chip -->
                <LinearLayout
                    android:id="@+id/chipMountain"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_mountain"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mountain"
                        android:contentDescription="Mountain"
                        app:tint="@color/chip_mountain"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mountain"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/chip_mountain"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Camping Chip -->
                <LinearLayout
                    android:id="@+id/chipCamping"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_camping"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_camping"
                        android:contentDescription="Camping"
                        app:tint="@color/chip_camping"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camping"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/chip_camping"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Popular Destination Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Popular Destination"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"/>

            <TextView
                android:id="@+id/seeAllPopular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See all"
                android:textSize="14sp"
                android:textColor="@color/primary_blue"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Popular Destinations Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/popularDestinationsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false"/>

        <!-- Nearby Me Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nearby Me"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"/>

            <TextView
                android:id="@+id/seeAllNearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See all"
                android:textSize="14sp"
                android:textColor="@color/primary_blue"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Nearby Destinations List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/nearbyDestinationsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="20dp"
            android:clipToPadding="false"/>

        <!-- Bottom Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"/>

    </LinearLayout>
</ScrollView>
