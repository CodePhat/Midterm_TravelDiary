<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_light"
    android:layout_marginBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Destination Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/destinationImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:contentDescription="Destination image"
            android:src="@drawable/sample_trip"
            app:shapeAppearanceOverlay="@style/RoundedImageView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Content Layout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/destinationImage"
            app:layout_constraintBottom_toBottomOf="@id/destinationImage"
            app:layout_constraintStart_toEndOf="@id/destinationImage"
            app:layout_constraintEnd_toStartOf="@id/distance">

            <!-- Destination Name -->
            <TextView
                android:id="@+id/destinationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Botok Beach"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="Location"
                    app:tint="@color/text_tertiary_light"/>

                <TextView
                    android:id="@+id/destinationLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sragen, Indonesia"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary_light"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Distance -->
        <TextView
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3,5km"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            app:layout_constraintTop_toTopOf="@id/destinationImage"
            app:layout_constraintBottom_toBottomOf="@id/destinationImage"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
